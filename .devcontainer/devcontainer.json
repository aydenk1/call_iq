{
  "name": "google-ads-feature",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.google-ads-feature.yml"
  ],
  "service": "call_iq",
  "runServices": ["call_iq"],
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python", 
        "ms-python.vscode-pylance", 
        "ms-python.debugpy", 
        "ms-python.isort", 
        "openai.chatgpt"
      ],
      "settings": {
        "python.analysis.extraPaths": ["${workspaceFolder}/src"],
        "python.analysis.exclude": ["**/data/**"],
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "files.watcherExclude": {
          "**/data/**": true
        },
        "search.exclude": {
          "**/data/**": true
        },
        "isort.importStrategy": "fromEnvironment",
        "isort.interpreter": ["/opt/venv/bin/python"]
      }
    }
  },
  "mounts": [
    "source=vscode-server,target=/root/.vscode-server,type=volume",
    "source=codex_home,target=/root/.codex,type=volume"
  ]
}
